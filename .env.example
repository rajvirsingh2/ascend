# ── Database ──────────────────────────────────────────────────────────
DB_NAME=ascend_db
DB_USER=ascend_user
DB_PASSWORD=ascend_pass
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgres://ascend_user:ascend_pass@postgres:5432/ascend_db?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth (run `make generate-secrets` to create these) ────────────────
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Encryption ────────────────────────────────────────────────────────
MASTER_ENCRYPTION_KEY=CHANGE_ME
HMAC_SECRET=CHANGE_ME

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# ── RAG Service ───────────────────────────────────────────────────────
RAG_SERVICE_URL=http://rag-service:8001

# ── Worker ────────────────────────────────────────────────────────────
WORKER_TYPE=xp

# ── 3rd Party Integrations (Optional) ─────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Ascend <onboarding@resend.dev>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=./firebase-service-account.json