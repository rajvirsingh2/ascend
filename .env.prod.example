# ═══════════════════════════════════════════════════════════
# Ascend — Production Environment Variables
# Copy to .env.prod and fill in all values
# ═══════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
DB_NAME=ascend_db
DB_USER=ascend_user
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgres://ascend_user:CHANGE_ME_USE_STRONG_PASSWORD@postgres:5432/ascend_db?sslmode=disable

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth (generate with: python3 -c "import secrets; print(secrets.token_hex(32))") ──
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Encryption ────────────────────────────────────────────
MASTER_ENCRYPTION_KEY=CHANGE_ME
HMAC_SECRET=CHANGE_ME

# ── App ───────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8080
ALLOWED_ORIGINS=https://yourdomain.com

# ── ML Model (HuggingFace Spaces) ────────────────────────
ML_SERVICE_URL=
HF_TOKEN=

# ── Worker ────────────────────────────────────────────────
WORKER_TYPE=xp

# ── 3rd Party Integrations ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Ascend <onboarding@resend.dev>"

# SMTP Config (Overrides Resend if set, allowing email without domain via Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=./firebase-service-account.json
